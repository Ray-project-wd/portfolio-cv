<%- include('partials/header') %>
<h1>Ganti password</h1>
<form class="form" method="post" action="/admin/password">
  <div class="field"><label for="current">Password saat ini</label><input id="current" type="password" name="current" autocomplete="current-password" required></div>
  <div class="field"><label for="next">Password baru</label><input id="next" type="password" name="next" minlength="8" autocomplete="new-password" required><small>Minimal 8 karakter.</small></div>
  <div class="field"><label for="confirm">Konfirmasi password baru</label><input id="confirm" type="password" name="confirm" minlength="8" autocomplete="new-password" required></div>
  <div class="form-actions"><button class="btn primary" type="submit">Simpan password</button></div>
</form>
<%- include('partials/footer') %>
